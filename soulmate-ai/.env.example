# Local development environment variables
# Copy this file to `.env` and fill in your real values.

# Claude AI (server-side only — do NOT prefix with EXPO_PUBLIC_)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Web search for live news and current events (server-side only)
# Free tier: 1,000 searches/month — https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Image generation with DALL-E 3 (server-side only)
# Dashboard: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
# Optional: defaults to gpt-image-2 (falls back to dall-e-3 if unavailable)
OPENAI_IMAGE_MODEL=gpt-image-2

# Supabase (Google sign-in)
# Dashboard: https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Use either name — publishable key (sb_publishable_...) or legacy anon key (eyJ...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ-your-anon-key-here

# Supabase service role (server-side only — invite system)
# Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated admin emails with unlimited invites
ADMIN_EMAILS=you@example.com

# Stripe subscriptions (server-side only, except price label)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-key-here
# Dashboard → Developers → Webhooks → add endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
# Dashboard → Products → create recurring price → copy price ID
STRIPE_PRICE_ID=price_your-monthly-price-id
EXPO_PUBLIC_STRIPE_PRICE_LABEL=$9.99/month

# Leave unset for web — the browser uses same-origin /api routes automatically.
# EXPO_PUBLIC_API_ORIGIN=https://soulmate-ai.expo.app

# --- Google Auth setup checklist ---
#
# 1. Supabase → Authentication → Providers → Google
#    - Enable Google and paste your Google OAuth Client ID + Secret
#
# 2. Google Cloud Console → APIs & Services → Credentials
#    - Create OAuth 2.0 Client ID (Web application)
#    - Authorized redirect URI: https://YOUR-PROJECT.supabase.co/auth/v1/callback
#
# 3. Supabase → Authentication → URL Configuration
#    - Site URL (prod): https://soulmate-ai.expo.app
#    - Redirect URLs (add all that apply):
#        http://localhost:**/**
#        https://soulmate-ai.expo.app/**
#        soulmateai://**
#        exp://**          (required for Expo Go on your phone)
#
# 4. Production (EAS Hosting): run scripts\deploy-live-site.cmd on your PC.
#    It uploads these vars to EAS production automatically from your .env file.
#    You need a real ANTHROPIC_API_KEY (not the placeholder).
#
#    Also add to Supabase Redirect URLs:
#        https://soulmate-ai.expo.app/**
#
# 5. After changing .env, restart Expo: npx expo start --clear
