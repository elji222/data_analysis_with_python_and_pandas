{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "environment": "production",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ios": {
      "environment": "production",
      "distribution": "store",
      "channel": "preview",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "preview-ios": {
      "ios": {}
    },
    "production": {
      "ios": {},
      "android": {}
    }
  }
}
